{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vite: dev",
      "type": "shell",
      "command": "bash scripts/dev.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "vite",
          "pattern": { "regexp": "^$" },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "> vite|VITE\\s+v\\d",
            "endsPattern": "ready in [0-9]+ ms|Local:\\s+http://localhost:[0-9]+"
          }
        }
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "focus": false
      }
    }
  ]
}
