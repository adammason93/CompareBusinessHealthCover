{
  // React + Vite SPA: serve static files from ./dist via Workers Assets.
  // "main" MUST be a Worker script — NOT ./dist/index.js (Vite writes index.html and hashed bundles there, not a Worker entry).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "healthinsuranceleadgenerationfinal",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-03-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}
